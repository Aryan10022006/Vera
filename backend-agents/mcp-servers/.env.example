# Vera Protocol MCP Servers Environment Configuration

# GitHub Integration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_TOKEN=your_github_personal_access_token

# Document Analysis APIs
GRAMMAR_API_KEY=your_grammar_api_key
PLAGIARISM_API_KEY=your_plagiarism_api_key
READABILITY_API_KEY=your_readability_api_key

# Design Tools APIs
FIGMA_TOKEN=your_figma_access_token
ADOBE_API_KEY=your_adobe_api_key
ACCESSIBILITY_API_KEY=your_accessibility_api_key

# Server Configuration
PORT=3002
NODE_ENV=development

# Logging
LOG_LEVEL=info