{
  "name": "vera-protocol-mcp-servers",
  "version": "1.0.0",
  "description": "External MCP servers for Vera Protocol multi-agent evaluation system",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start:github-mcp": "node dist/github-integration-mcp.js",
    "start:document-mcp": "node dist/document-analysis-mcp.js",
    "start:design-mcp": "node dist/design-tools-mcp.js",
    "start:vera-github-mcp": "node dist/vera-github-mcp.js",
    "dev:github-mcp": "tsx github-integration-mcp.ts",
    "dev:document-mcp": "tsx document-analysis-mcp.ts",
    "dev:design-mcp": "tsx design-tools-mcp.ts",
    "dev:vera-github-mcp": "tsx watch vera-github-mcp.ts",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@octokit/rest": "^20.0.0",
    "@octokit/auth-oauth-app": "^7.0.0",
    "ethers": "^6.8.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/jest": "^29.0.0",
    "typescript": "^5.2.0",
    "tsx": "^4.0.0",
    "jest": "^29.0.0",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0"
  },
  "keywords": [
    "vera-protocol",
    "mcp",
    "ai-agents",
    "evaluation",
    "github",
    "document-analysis",
    "design-tools",
    "oauth",
    "verification"
  ],
  "author": "Vera Protocol Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}