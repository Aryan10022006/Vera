# Vera Protocol Webhook Server Configuration

# Server Configuration
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://vera-protocol.vercel.app

# GitHub Configuration
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Ethereum Configuration
ARBITER_PRIVATE_KEY=your_ai_agent_private_key
CONTRACT_ADDRESS=your_deployed_vera_escrow_contract_address
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your_infura_project_id

# IPFS Configuration
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# Database (Optional - for production scaling)
DATABASE_URL=postgresql://user:password@localhost:5432/vera_protocol

# Security
JWT_SECRET=your_jwt_secret_for_api_authentication
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring
SENTRY_DSN=your_sentry_dsn_for_error_tracking
LOG_LEVEL=info

# Security Note: Never commit actual secrets to version control