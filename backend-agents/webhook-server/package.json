{
  "name": "vera-webhook-server",
  "version": "1.0.0",
  "description": "Production webhook server for Vera Protocol",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.ts",
    "build": "tsc index.ts --outDir dist --target es2020 --module esnext --moduleResolution node",
    "docker:build": "docker build -t vera-webhook-server .",
    "docker:run": "docker run -p 3001:3001 vera-webhook-server"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.9.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "keywords": [
    "vera-protocol",
    "webhook",
    "github",
    "automation"
  ],
  "author": "Vera Protocol Team",
  "license": "MIT"
}