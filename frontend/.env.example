# Blockchain
VITE_CONTRACT_ADDRESS=0xF6c7481A8760647Cf9706815E1072Cf074E85F51

# IPFS (Pinata)
VITE_PINATA_JWT=your_pinata_jwt_token_here
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud

# WalletConnect (optional - has fallback to 'vera-protocol-default')
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# WebSocket
VITE_WEBSOCKET_URL=ws://localhost:3001

# Firebase Authentication (Get from Firebase Console > Project Settings > Your apps > Web app)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# GitHub OAuth
VITE_GITHUB_CLIENT_ID=your_github_client_id

